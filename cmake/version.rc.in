#include <winres.h>


1 VERSIONINFO
	FILEVERSION @PLUGIN_VERSION_MAJOR@, @PLUGIN_VERSION_MINOR@, @PLUGIN_VERSION_PATCH@, @PLUGIN_VERSION_TWEAK@
	PRODUCTVERSION @PLUGIN_VERSION_MAJOR@, @PLUGIN_VERSION_MINOR@, @PLUGIN_VERSION_PATCH@, @PLUGIN_VERSION_TWEAK@
	FILEFLAGSMASK 0x17L
#ifdef _DEBUG
	FILEFLAGS 0x1L
#else
	FILEFLAGS 0x0L
#endif
	FILEOS 0x4L
	FILETYPE 0x1L
	FILESUBTYPE 0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "@PLUGIN_DISPLAY_NAME_CPP@"
			VALUE "FileVersion", "@PLUGIN_VERSION_MAJOR@.@PLUGIN_VERSION_MINOR@.@PLUGIN_VERSION_PATCH@.@PLUGIN_VERSION_TWEAK@"
			VALUE "InternalName", "@PLUGIN_BINARY_NAME@"
			VALUE "ProductName", "@PLUGIN_DISPLAY_NAME_CPP@"
			VALUE "ProductVersion",  "@PLUGIN_VERSION_MAJOR@.@PLUGIN_VERSION_MINOR@.@PLUGIN_VERSION_PATCH@.@PLUGIN_VERSION_TWEAK@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
